    %% SIRAM — modelo de datos canónico (fuente de verdad del dominio)
    %% Versión 1 · 2026-10-08 · SIRAM trata casos; la denuncia es un dato anotado en el caso (ver decisiones.md).
    %% Versión 0 · 2026-10-08 · línea base tomada de recursos/diseno/«De las pantallas al modelo.html»
    %% + atributos de ORGANISMO y USUARIO tomados de recursos/modelo-er/siram-modelo-er.svg.
    %% ES UNA PROPUESTA ABIERTA: brechas conocidas en ../CONTEXTO.md §7. Cambios y su porqué en decisiones.md.
    ORGANISMO ||--o{ USUARIO : agrupa
    USUARIO ||--o{ DENUNCIA : anota
    USUARIO ||--o{ CASO : registra
    CASO ||--o{ DENUNCIA : "tiene anotada"
    PERSONA |o--o{ DENUNCIA : "la hizo"
    CASO ||--o{ PARTICIPACION : involucra
    PERSONA ||--o{ PARTICIPACION : "participa como"
    CASO ||--|| ANIMAL : describe
    CASO ||--o{ DOCUMENTO : adjunta
    CASO ||--o{ COINCIDENCIA : "caso A"
    CASO ||--o{ COINCIDENCIA : "caso B"
    CASO ||--o| CASO : "unificado en"
    TIPO_EVENTO ||--o{ CASO : clasifica
    CASO ||--o{ AUDITORIA : registra
    DENUNCIA ||--o{ AUDITORIA : registra

    ORGANISMO {
        id id PK
        string nombre
        enum tipo
    }
    USUARIO {
        id id PK
        id organismo_id FK
        string nombre
        enum rol
    }
    DENUNCIA {
        id id PK
        id caso_id FK "obligatorio: nunca existe sola"
        string ente "Zoonosis, policía… (lista a definir con el cliente)"
        string numero "nro. de trámite o acta, si se consigue"
        date fecha "H0, fecha de la denuncia, si se conoce"
        id denunciante_persona_id FK "quien la hizo, si se conoce"
        id usuario_id FK "quien la anotó en SIRAM"
        datetime anotada_en
    }
    CASO {
        id id PK
        enum estado "registrado|en_seguimiento|finalizado|desestimado|unificado"
        enum motivo_espera "contacto|respuesta|certificado"
        id unificado_en_caso_id FK
        date fecha_hecho
        time hora_hecho
        string ciudad
        string lugar
        point coordenadas
        enum tipo_lugar
        enum tipo_lesion
        enum zona_cuerpo
        enum gravedad
        bool atencion_medica
        enum hizo_denuncia "si|no (nulo = sin dato)"
        string motivo_no_denuncia "D3"
    }
    COINCIDENCIA {
        id id PK
        id caso_a_id FK
        id caso_b_id FK
        enum tipo "duplicado|evento_relacionado"
        int puntaje
        json senales
        enum revision "pendiente|resuelta|descartada"
        id resuelta_por FK
    }
    PERSONA {
        id id PK
        string nombre
        string dni "obligatorio salvo registros históricos (RN-21)"
        int edad
        string telefono
        string correo
        string domicilio
    }
    PARTICIPACION {
        id caso_id FK
        id persona_id FK
        enum rol "victima|denunciante"
        string vinculo "madre, padre, vecino"
    }
    ANIMAL {
        id id PK
        enum especie
        enum tamano
        string color
        string raza
        enum sexo
        enum origen_tenencia
        bool reincidente
        string zona_domicilio
    }
    AUDITORIA {
        id id PK
        enum entidad "caso|denuncia"
        id entidad_id
        enum actor "usuario|sistema"
        id usuario_id FK
        string accion
        datetime fecha
    }
